---
/**
 * Ideas & Expression (route kept at /beyond so existing links work).
 * Each section renders only the material it has: feature image, body,
 * highlights, items, excerpts, gallery, recordings, video, reflection.
 */
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import Figure from '../components/Figure.astro';
import Gallery from '../components/Gallery.astro';
import Excerpt from '../components/Excerpt.astro';
import Recording from '../components/Recording.astro';
import Reflection from '../components/Reflection.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { getPublishedBeyond, getSite } from '../lib/content';
import { href as withBase, isExternal } from '../lib/url';

const sections = await getPublishedBeyond();
const site = await getSite();
const description =
  'Ideas and expression: economics, history and philosophy, music, and public speaking in the life of Pakawat (Messi) Poldetch.';
---

<Base title="Ideas & Expression" description={description}>
  <section class="page-head">
    <div class="wrap page-head__grid">
      <div>
        <p class="eyebrow eyebrow--cobalt">Ideas & expression</p>
        <h1>Other ways of asking</h1>
      </div>
      <div class="page-head__intro prose prose--lead">
        <p>
          Not everything I do is research, and not everything needs to be. These are the other parts
          of my life: some feed the same questions from a different direction, and some are simply
          things I care about.
        </p>
      </div>
      <nav class="jump page-head__jump" aria-label="Sections on this page">
        {sections.map((s) => <a href={`#${s.id}`}>{s.data.title}</a>)}
      </nav>
    </div>
  </section>

  {
    sections.map((section, i) => {
      const d = section.data;
      const highlights = (d.highlights ?? []).filter((h) => h.published !== false);
      const items = (d.items ?? []).filter((it) => it.published !== false);
      const excerpts = (d.excerpts ?? []).filter((e) => e.published !== false);
      const recordings = (d.recordings ?? []).filter((r) => r.published !== false && (r.src || r.href));
      const gallery = (d.gallery ?? []).filter((g) => g.published !== false);
      const feature = d.featureImage && d.featureImage.published !== false ? d.featureImage : undefined;
      const video = d.video && d.video.published !== false ? d.video : undefined;
      const tint = i % 2 === 1;
      return (
        <section class:list={['section', 'section--rule', 'topic', { 'section--tint': tint }]} id={section.id}>
          <div class="wrap topic__grid">
            <header class="topic__head">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="topic__title">{d.title}</h2>
              <p class="topic__lede">{d.lede}</p>
              {highlights.length > 0 && (
                <ul class="plain-list highlights">
                  {highlights.map((h) => (
                    <li class="highlight">
                      {h.href ? (
                        <a class="highlight__label" href={withBase(h.href)} target={isExternal(h.href) ? '_blank' : undefined} rel={isExternal(h.href) ? 'noopener' : undefined}>
                          {h.label}
                        </a>
                      ) : (
                        <span class="highlight__label">{h.label}</span>
                      )}
                      {h.detail && <span class="highlight__detail mono">{h.detail}</span>}
                    </li>
                  ))}
                </ul>
              )}
            </header>

            <div class="topic__body">
              {feature && (
                <div class="topic__feature">
                  <Figure image={feature} ratio="16/10" sizes="(min-width: 76rem) 50rem, 100vw" />
                </div>
              )}
              <Prose text={d.body} />

              {video && (
                <div class="topic__video">
                  <VideoEmbed video={video} />
                </div>
              )}

              {items.length > 0 && (
                <ul class="plain-list items">
                  {items.map((it) => (
                    <li class="item">
                      <h3 class="item__title">
                        {it.href ? (
                          <a href={withBase(it.href)} target={isExternal(it.href) ? '_blank' : undefined} rel={isExternal(it.href) ? 'noopener' : undefined}>
                            {it.title}
                          </a>
                        ) : (
                          it.title
                        )}
                      </h3>
                      {(it.role || it.period) && (
                        <p class="item__meta mono">
                          {it.role}
                          {it.role && it.period && ' · '}
                          {it.period}
                        </p>
                      )}
                      {it.description && <Prose text={it.description} muted small />}
                    </li>
                  ))}
                </ul>
              )}

              {excerpts.length > 0 && (
                <div class="topic__excerpts">
                  <p class="eyebrow">{d.excerptsHeading ?? 'Excerpts'}</p>
                  <div class="topic__excerpt-grid">
                    {excerpts.map((e) => (
                      <Excerpt excerpt={e} />
                    ))}
                  </div>
                </div>
              )}

              {(recordings.length > 0 || d.recordingsPlaceholder) && (
                <div class="topic__recordings">
                  <p class="eyebrow">{d.recordingsHeading ?? 'Recordings'}</p>
                  {recordings.length > 0 ? (
                    <div class="topic__recording-list">
                      {recordings.map((r) => (
                        <Recording recording={r} />
                      ))}
                    </div>
                  ) : (
                    <div class="slot" aria-label={`Placeholder: ${d.recordingsPlaceholder}`}>
                      <span class="slot__bar" />
                      <span class="slot__bar slot__bar--short" />
                      {site.showPlaceholderLabels && <span class="slot__label">{d.recordingsPlaceholder}</span>}
                    </div>
                  )}
                </div>
              )}

              {d.reflection && (
                <div class="topic__reflection">
                  <Reflection reflection={d.reflection} />
                </div>
              )}
            </div>

            {gallery.length > 0 && (
              <div class="topic__gallery">
                {d.galleryHeading && <p class="eyebrow">{d.galleryHeading}</p>}
                <Gallery images={gallery} columns={Math.min(gallery.length, 3)} ratio="3/2" pattern={gallery.length >= 3 ? 'even' : 'even'} />
              </div>
            )}
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  .topic__grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 60em) {
    .topic__grid {
      grid-template-columns: minmax(14rem, 1fr) 2.2fr;
      gap: var(--space-6) var(--space-8);
    }
    .topic__head {
      position: sticky;
      top: 5.5rem;
      align-self: start;
    }
    .topic__gallery {
      grid-column: 1 / -1;
    }
  }
  .topic__head .index {
    display: block;
    margin-bottom: var(--space-3);
  }
  .topic__title {
    margin-bottom: 0.3rem;
  }
  .topic__lede {
    font-size: var(--text-h4);
    font-weight: 400;
    color: var(--ink-2);
    margin: 0 0 var(--space-5);
  }
  .topic__body {
    display: grid;
    gap: var(--space-6);
    max-width: 44rem;
  }
  .topic__feature {
    margin-bottom: var(--space-2);
  }

  .highlights {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }
  .highlight {
    display: grid;
    gap: 0.15rem;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line-strong);
  }
  .highlight__label {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--ink);
  }
  .highlight__detail {
    color: var(--teal);
  }

  .items {
    display: grid;
    gap: var(--space-4);
  }
  .item {
    display: grid;
    gap: 0.3rem;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .item__title {
    font-size: var(--text-h4);
    margin: 0;
  }
  .item__title a {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
  }
  .item__meta {
    margin: 0;
  }

  .topic__excerpt-grid,
  .topic__recording-list {
    display: grid;
    gap: var(--space-4);
  }
  .slot {
    position: relative;
    display: grid;
    gap: 0.8rem;
    padding: var(--space-5) var(--space-5) 2.8rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
  }
  .slot__bar {
    display: block;
    height: 1px;
    background: var(--line-strong);
  }
  .slot__bar--short {
    width: 60%;
  }
  .slot__label {
    position: absolute;
    left: var(--space-5);
    bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
</style>
