---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import StatusPill from '../../components/StatusPill.astro';
import Publication from '../../components/Publication.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import { getPublishedProjects, getPublishedPublications } from '../../lib/content';
import { href } from '../../lib/url';

const projects = await getPublishedProjects();
const publications = await getPublishedPublications();
const description =
  'Case studies of research and projects by Pakawat (Messi) Poldetch: aquaculture research and antimicrobial resistance, ShrimpPulse, neuroscience and connectomics, and Telesync.';
---

<Base title="Research & Projects" description={description}>
  <section class="page-head">
    <div class="wrap page-head__grid">
      <div>
        <p class="eyebrow eyebrow--cobalt">Research & projects</p>
        <h1>Case studies</h1>
      </div>
      <div class="page-head__intro prose prose--lead">
        <p>
          Each project is written the same way: the question, the approach, what I contributed, what
          the evidence shows so far, and the question that comes next. My own contribution is kept
          distinct from my collaborators' work, and finished results from intended benefits.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ol class="plain-list studies">
        {
          projects.map((p, i) => {
            const url = href(`/work/${p.id}`);
            const image = p.data.card ?? p.data.hero;
            const big = i === 0;
            return (
              <li class:list={['study', { 'study--big': big, 'study--flip': !big && i % 2 === 0 }]}>
                <a class="study__media" href={url} tabindex="-1" aria-hidden="true">
                  <Figure
                    image={{ ...image, frame: 'none' }}
                    ratio={big ? '16/9' : '4/3'}
                    loading={big ? 'eager' : 'lazy'}
                    sizes={big ? '(min-width: 76rem) 76rem, 100vw' : '(min-width: 60em) 34rem, (min-width: 48em) 48vw, 100vw'}
                    placeholder={image?.placeholder ?? p.data.title}
                  />
                </a>
                <div class="study__body">
                  <p class="eyebrow">
                    <span class="index">{String(i + 1).padStart(2, '0')}</span> · {p.data.area}
                  </p>
                  <h2 class="study__title">
                    <a href={url}>{p.data.title}</a>
                  </h2>
                  <p class="study__summary">{p.data.summary}</p>
                  <div class="study__meta">
                    <StatusPill label={p.data.status.label} tone={p.data.status.tone} />
                    {p.data.role && <span class="study__role mono">{p.data.role}</span>}
                  </div>
                  <Button href={`/work/${p.id}`} variant="link">Read the case study</Button>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  {
    publications.length > 0 && (
      <section class="section section--rule">
        <div class="wrap pubs__grid">
          <div>
            <SectionHeading
              eyebrow="Publications"
              title="Peer-reviewed papers"
              intro="Co-authored studies in aquaculture health and nutrition. The research context is on the aquaculture page."
            />
            <Button href="/work/aquaculture-research" variant="link">Aquaculture research</Button>
          </div>
          <div class="pubs__list">
            {publications.map((pub) => (
              <Publication publication={pub} compact />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .studies {
    display: grid;
    gap: var(--space-8);
  }
  .study {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  .study--big {
    gap: var(--space-5);
  }
  @media (min-width: 48em) {
    .study:not(.study--big) {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-7);
    }
    .study--flip .study__media {
      order: 2;
    }
    .study--big .study__body {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
      align-items: start;
    }
    .study--big .study__body .eyebrow {
      grid-column: 1 / -1;
    }
    .study--big .study__title {
      grid-row: 2 / 4;
    }
  }
  .study__media {
    display: block;
  }
  .study__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }
  .study__body .eyebrow {
    margin-bottom: 0;
  }
  .study__title {
    font-size: var(--text-h2);
    margin: 0;
  }
  .study__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .study__title a:hover {
    color: var(--cobalt-ink);
  }
  .study__summary {
    color: var(--ink-2);
    max-width: 48ch;
    margin: var(--space-2) 0 var(--space-3);
  }
  .study__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .pubs__grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 60em) {
    .pubs__grid {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--space-8);
    }
  }
  .pubs__list {
    border-bottom: 1px solid var(--line);
  }
</style>
