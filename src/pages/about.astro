---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import Prose from '../components/Prose.astro';
import Mark from '../components/Mark.astro';
import DatedList from '../components/DatedList.astro';
import Reflection from '../components/Reflection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import { getSite } from '../lib/content';

const entry = await getEntry('about', 'about');
if (!entry) throw new Error('src/content/about.yaml is missing');
const about = entry.data;
const site = await getSite();
const activityPhoto = about.activityPhoto && about.activityPhoto.published !== false ? about.activityPhoto : undefined;
---

<Base title={about.metaTitle ?? 'About'} description={about.metaDescription}>
  <section class="about-hero">
    <div class="wrap about-hero__grid">
      <div class="about-hero__media">
        <Figure image={about.portrait} ratio="3/4" loading="eager" sizes="(min-width: 60em) 24rem, (min-width: 48em) 38vw, 86vw" />
      </div>
      <div class="about-hero__text">
        <p class="eyebrow">{about.heading}</p>
        <h1 class="about-hero__title">{site.firstName} <span>“{site.nickname}”</span> {site.surname}</h1>
        <Prose text={about.opening} lead />
        <div class="about-hero__sign">
          <Mark size="md" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="currently">
    <div class="wrap aside-grid">
      <div>
        <SectionHeading eyebrow="Now" title={about.currently.heading} intro={about.currently.intro} />
      </div>
      <DatedList items={about.currently.items} showArchived={about.currently.showArchived} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHeading title={about.interests.heading} />
      <dl class="ledger">
        {
          about.interests.items.map((item, i) => (
            <div class="ledger__row">
              <dt class="ledger__term">
                <span class="index">{String(i + 1).padStart(2, '0')}</span>
                <span>{item.title}</span>
              </dt>
              <dd class="ledger__desc">
                <Prose text={item.body} />
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap studies__grid">
      <div class="studies">
        <p class="eyebrow">{about.studies.heading}</p>
        <p class="studies__programme">{about.studies.programme}</p>
        <ul class="plain-list studies__list">
          {about.studies.items.map((s) => <li>{s}</li>)}
        </ul>
        {about.studies.note && <p class="studies__note">{about.studies.note}</p>}
      </div>
      {
        activityPhoto && (
          <div class="studies__photo">
            <Figure image={activityPhoto} ratio="3/2" sizes="(min-width: 60em) 40rem, 100vw" />
          </div>
        )
      }
    </div>
  </section>

  <section class="section section--navy questions">
    <div class="wrap">
      <SectionHeading title={about.questions.heading} intro={about.questions.intro} align="split" tone="dark" />
      <ol class="plain-list questions__list">
        {
          about.questions.items.map((q, i) => (
            <li class="questions__item">
              <span class="questions__index mono">{String(i + 1).padStart(2, '0')}</span>
              <p class="questions__text">{q}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section directions">
    <div class="wrap aside-grid">
      <div>
        <SectionHeading title={about.directions.heading} />
      </div>
      <div>
        <Prose text={about.directions.body} lead />
        <p class="directions__link">
          <Button href="/work" variant="link">See the work so far</Button>
        </p>
      </div>
    </div>
  </section>

  {
    about.reflection && (
      <section class="section section--rule">
        <div class="wrap--narrow">
          <Reflection reflection={about.reflection} />
        </div>
      </section>
    )
  }
</Base>

<style>
  .about-hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) var(--space-8);
  }
  .about-hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 48em) {
    .about-hero__grid {
      grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.25fr);
      gap: clamp(2rem, 6vw, 5rem);
    }
  }
  .about-hero__media {
    max-width: 24rem;
    width: 100%;
  }
  .about-hero__title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-5);
  }
  .about-hero__title span {
    color: var(--cobalt-ink);
  }
  .about-hero__text :global(.prose--lead) {
    max-width: 54ch;
    font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.35rem);
  }
  .about-hero__sign {
    margin-top: var(--space-5);
  }

  .aside-grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 60em) {
    .aside-grid {
      grid-template-columns: minmax(14rem, 1fr) 2fr;
      gap: var(--space-8);
    }
  }

  .ledger {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .ledger__row {
    display: grid;
    gap: var(--space-3) var(--space-6);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 48em) {
    .ledger__row {
      grid-template-columns: minmax(12rem, 1fr) 2.2fr;
    }
  }
  .ledger__term {
    display: grid;
    gap: 0.4rem;
    font-family: var(--font-head);
    font-size: var(--text-h4);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .ledger__desc {
    margin: 0;
    color: var(--ink-2);
  }
  .ledger__desc :global(.prose) {
    max-width: none;
  }

  .studies__grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 60em) {
    .studies__grid {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-8);
    }
  }
  .studies__programme {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--text-h4);
    margin-bottom: var(--space-4);
  }
  .studies__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .studies__list li {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .studies__note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--ink-3);
  }

  .questions__list {
    display: grid;
    border-top: 1px solid var(--navy-line);
  }
  .questions__item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--navy-line);
    align-items: baseline;
  }
  .questions__index {
    color: #8fa6ff;
  }
  .questions__text {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--text-h3);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 30ch;
    text-wrap: pretty;
  }
  .directions__link {
    margin-top: var(--space-5);
  }
</style>
