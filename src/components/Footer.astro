---
import Mark from './Mark.astro';
import { getSite } from '../lib/content';
import { href } from '../lib/url';

const site = await getSite();
const year = new Date().getFullYear();
const cv = site.cv && site.cv.published && site.cv.href ? site.cv : undefined;
---

<footer class="site-footer">
  <div class="wrap footer">
    <div class="footer__identity">
      <Mark size="md" tone="dark" />
      <p class="footer__name">{site.name}</p>
      <p class="footer__meta mono">{site.school} · {site.location} · {site.cohort}</p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <ul class="plain-list footer__links">
        {site.nav.map((item) => (
          <li>
            <a href={href(item.href)}>{item.label}</a>
          </li>
        ))}
      </ul>
      <ul class="plain-list footer__links footer__links--contact">
        {site.linkedin && (
          <li>
            <a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
          </li>
        )}
        {site.email && (
          <li>
            <a href={`mailto:${site.email}`}>Email</a>
          </li>
        )}
        {cv && (
          <li>
            <a href={href(cv.href)} download={cv.kind === 'download' ? '' : undefined}>{cv.label}</a>
          </li>
        )}
      </ul>
    </nav>

    <p class="footer__note mono">
      © {year} {site.name}. {site.footerNote ?? ''}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: var(--on-navy);
    margin-top: var(--space-8);
  }
  .footer {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-6);
  }
  @media (min-width: 48em) {
    .footer {
      grid-template-columns: 1.3fr 1fr;
      grid-template-areas:
        'identity nav'
        'note nav';
    }
    .footer__identity {
      grid-area: identity;
    }
    .footer__nav {
      grid-area: nav;
      justify-self: end;
    }
    .footer__note {
      grid-area: note;
      align-self: end;
    }
  }
  .footer__name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--text-h4);
    margin: var(--space-4) 0 0.2rem;
  }
  .footer__meta {
    color: var(--on-navy-3);
    margin: 0;
  }
  .footer__nav {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: auto auto;
    align-items: start;
  }
  .footer__links {
    display: grid;
    gap: 0.5rem;
  }
  .footer__links a {
    font-family: var(--font-head);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--on-navy-2);
    text-decoration: none;
  }
  .footer__links a:hover {
    color: var(--on-navy);
  }
  .footer__links--contact a {
    color: var(--on-navy);
    border-bottom: 1px solid var(--navy-line);
  }
  .footer__note {
    color: var(--on-navy-3);
    margin: 0;
  }
</style>
