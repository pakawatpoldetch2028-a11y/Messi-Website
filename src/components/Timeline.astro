---
/** A compact dated timeline; horizontal on wide screens, vertical on small. */
import Prose from './Prose.astro';
import { formatDate } from '../lib/dates';

interface Props {
  items: { date: string; title: string; body?: string }[];
  compact?: boolean;
}
const { items, compact = false } = Astro.props;
---

<ol class:list={['plain-list', 'timeline', { 'timeline--compact': compact }]}>
  {
    items.map((item) => (
      <li class="timeline__item">
        <span class="timeline__dot" aria-hidden="true" />
        <span class="timeline__date mono">{formatDate(item.date)}</span>
        <p class="timeline__title">{item.title}</p>
        {item.body && <Prose text={item.body} muted small class="timeline__text" />}
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    display: grid;
    gap: var(--space-4);
    position: relative;
    padding-left: 1.1rem;
    border-left: 1px solid var(--line-strong);
  }
  .timeline__item {
    position: relative;
    display: grid;
    gap: 0.15rem;
  }
  .timeline__dot {
    position: absolute;
    left: calc(-1.1rem - 5px);
    top: 0.45rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--cobalt);
    box-shadow: 0 0 0 3px var(--bg);
  }
  .timeline__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.35;
  }
  .timeline__item :global(.timeline__text) {
    font-size: 0.85rem;
  }

  @media (min-width: 60em) {
    .timeline--compact {
      grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
      gap: var(--space-4);
      padding-left: 0;
      padding-top: 1.1rem;
      border-left: 0;
      border-top: 1px solid var(--line-strong);
    }
    .timeline--compact .timeline__dot {
      left: 0;
      top: calc(-1.1rem - 5px);
    }
  }
</style>
