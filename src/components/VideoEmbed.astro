---
/**
 * Optional video: a YouTube link or a file in public/. With neither, it
 * renders a labelled placeholder frame (if `placeholder` is set) or nothing.
 * No player controls are shown without media.
 */
import Figure from './Figure.astro';
import { href } from '../lib/url';
import { mdInline } from '../lib/markdown';
import { formatDate } from '../lib/dates';

interface Props {
  video?: {
    title?: string;
    date?: string;
    youtube?: string;
    src?: string;
    caption?: string;
    placeholder?: string;
    published?: boolean;
  };
  placeholder?: string;
  ratio?: string;
}
const { video, placeholder, ratio = '16/9' } = Astro.props;

function youtubeId(url: string): string | undefined {
  const m = url.match(/(?:youtu\.be\/|v=|\/embed\/|\/shorts\/)([\w-]{6,})/);
  return m?.[1];
}

const visible = !video || video.published !== false;
const hasMedia = visible && video && (video.youtube || video.src);
const id = video?.youtube ? youtubeId(video.youtube) : undefined;
const label = video?.placeholder ?? placeholder;
---

{
  hasMedia ? (
    <figure class="video" style={`--ratio: ${ratio};`}>
      <div class="video__frame">
        {id ? (
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${id}`}
            title={video?.title ?? 'Video'}
            loading="lazy"
            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        ) : (
          <video controls preload="metadata" src={href(video!.src!)}>
            <p>
              Your browser cannot play this video. <a href={href(video!.src!)}>Download it instead.</a>
            </p>
          </video>
        )}
      </div>
      {(video?.title || video?.caption || video?.date) && (
        <figcaption class="video__caption">
          {video?.date && <span class="mono">{formatDate(video.date)}</span>}
          {video?.title && <span class="video__title">{video.title}</span>}
          {video?.caption && <span set:html={mdInline(video.caption)} />}
        </figcaption>
      )}
    </figure>
  ) : visible && label ? (
    <Figure image={{ placeholder: label, alt: '' }} ratio={ratio} sizes="(min-width: 76rem) 48rem, 100vw" />
  ) : null
}

<style>
  .video {
    margin: 0;
  }
  .video__frame {
    position: relative;
    aspect-ratio: var(--ratio);
    background: var(--navy);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .video__frame iframe,
  .video__frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video__caption {
    display: grid;
    gap: 0.2rem;
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .video__title {
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--ink);
  }
</style>
