---
interface Props {
  label: string;
  tone?: 'active' | 'complete' | 'planned';
}
const { label, tone = 'active' } = Astro.props;
---

<span class:list={['pill', `pill--${tone}`, 'sans']}>
  <span class="pill__dot" aria-hidden="true"></span>
  {label}
</span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.74rem;
    font-weight: 540;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    padding: 0.3rem 0.7rem 0.3rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper);
    white-space: nowrap;
  }
  .pill__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .pill--complete .pill__dot {
    background: var(--ink-3);
  }
  .pill--planned .pill__dot {
    background: var(--accent-2);
  }
</style>
