---
interface Props {
  label: string;
  tone?: 'active' | 'complete' | 'planned';
}
const { label, tone = 'active' } = Astro.props;
---

<span class:list={['pill', `pill--${tone}`]}>
  <span class="pill__dot" aria-hidden="true"></span>
  {label}
</span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    padding: 0.32rem 0.7rem 0.32rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    line-height: 1.35;
    text-align: left;
  }
  .pill__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
    flex-shrink: 0;
  }
  .pill--complete .pill__dot {
    background: var(--ink-3);
  }
  .pill--planned .pill__dot {
    background: var(--orange);
  }
</style>
