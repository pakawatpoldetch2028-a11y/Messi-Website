---
/**
 * The frame shown in an image slot that has no file yet. Drawn with CSS and
 * a tiny inline SVG so it never produces a broken-image icon.
 */
import { getSite } from '../lib/content';

interface Props {
  label?: string;
  tone?: 'light' | 'dark';
}
const { label, tone = 'light' } = Astro.props;
const site = await getSite();
const showLabel = site.showPlaceholderLabels && label;
---

<div class:list={['placeholder', `placeholder--${tone}`]} role="img" aria-label={label ? `Placeholder: ${label}` : 'Image placeholder'}>
  <svg class="placeholder__glyph" viewBox="0 0 48 48" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
      <path d="M10 34 L20 18 L30 26 L38 12" />
    </g>
    <g fill="currentColor">
      <circle cx="10" cy="34" r="2.2" />
      <circle cx="20" cy="18" r="2.2" />
      <circle cx="30" cy="26" r="2.2" />
      <circle cx="38" cy="12" r="2.2" />
    </g>
  </svg>
  {showLabel && <span class="placeholder__label">{label}</span>}
</div>

<style>
  .placeholder {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: var(--bg-2);
    background-image: radial-gradient(color-mix(in oklab, var(--line-strong) 70%, transparent) 1px, transparent 1px);
    background-size: 14px 14px;
    background-position: 7px 7px;
    color: var(--line-strong);
  }
  .placeholder::after {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px dashed color-mix(in oklab, var(--line-strong) 80%, transparent);
    border-radius: 6px;
    pointer-events: none;
  }
  .placeholder--dark {
    background-color: var(--navy-2);
    background-image: radial-gradient(color-mix(in oklab, var(--navy-line) 90%, transparent) 1px, transparent 1px);
    color: var(--navy-line);
  }
  .placeholder--dark::after {
    border-color: var(--navy-line);
  }
  .placeholder__glyph {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 28px;
    height: 28px;
  }
  .placeholder__label {
    position: absolute;
    left: 18px;
    bottom: 18px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .placeholder--dark .placeholder__label {
    color: var(--on-navy-3);
  }
</style>
