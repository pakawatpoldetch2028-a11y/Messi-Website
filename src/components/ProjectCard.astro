---
/**
 * A project preview. `variant="lead"` is the large featured composition;
 * `variant="small"` is the compact card.
 */
import type { CollectionEntry } from 'astro:content';
import Figure from './Figure.astro';
import StatusPill from './StatusPill.astro';
import Prose from './Prose.astro';
import { href } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  variant?: 'lead' | 'small';
  note?: string;
  eager?: boolean;
  index?: string;
}
const { project, variant = 'small', note, eager = false, index } = Astro.props;
const { data } = project;
const image = data.card ?? data.hero;
const url = href(`/work/${project.id}`);
const isLead = variant === 'lead';
---

<article class:list={['card', `card--${variant}`]}>
  <a class="card__media" href={url} tabindex="-1" aria-hidden="true">
    <Figure
      image={image}
      ratio={isLead ? '16/10' : '4/3'}
      sizes={isLead ? '(min-width: 76rem) 46rem, (min-width: 48em) 60vw, 100vw' : '(min-width: 76rem) 36rem, (min-width: 48em) 50vw, 100vw'}
      loading={eager ? 'eager' : 'lazy'}
      placeholder={image?.placeholder ?? data.title}
    />
  </a>
  <div class="card__body">
    <p class="eyebrow">
      {index && <span class="index">{index} · </span>}
      {data.area}
    </p>
    <h3 class="card__title">
      <a href={url}>{data.title}</a>
    </h3>
    <p class="card__summary">{data.summary}</p>
    {isLead && note && <Prose text={note} small muted class="card__note" />}
    <div class="card__foot">
      <StatusPill label={data.status.label} tone={data.status.tone} />
      <span class="card__cta">Read the case study →</span>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
  }
  .card__media {
    display: block;
    border-radius: var(--radius-lg);
  }
  .card__media :global(.figure__frame) {
    transition: transform var(--dur) var(--ease);
  }
  .card:hover .card__media :global(.figure__frame) {
    transform: translateY(-3px);
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }
  .card__body .eyebrow {
    margin-bottom: 0;
  }
  .card__title {
    font-size: var(--text-h3);
    margin: 0;
  }
  .card--lead .card__title {
    font-size: var(--text-h2);
  }
  .card__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__title a:hover {
    color: var(--cobalt-ink);
  }
  .card__summary {
    color: var(--ink-2);
    margin: 0;
    max-width: 48ch;
  }
  .card--lead .card__summary {
    font-size: var(--text-lead);
    line-height: 1.4;
  }
  .card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: auto;
    padding-top: var(--space-3);
  }
  .card__cta {
    font-family: var(--font-head);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--cobalt-ink);
  }

  @media (min-width: 48em) {
    .card--lead {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: var(--space-6);
      align-items: end;
    }
  }
</style>
