---
/**
 * A compact list of dated entries (current work, project updates).
 * Archived entries are hidden unless `showArchived` is true.
 */
import Prose from './Prose.astro';
import { formatDate } from '../lib/dates';
import { href as withBase, isExternal } from '../lib/url';

interface Props {
  items: {
    title: string;
    date: string;
    body?: string;
    href?: string;
    hrefLabel?: string;
    status?: 'active' | 'archived';
    published?: boolean;
  }[];
  showArchived?: boolean;
}
const { items, showArchived = false } = Astro.props;
const visible = items
  .filter((i) => i.published !== false && (showArchived || i.status !== 'archived'))
  .sort((a, b) => b.date.localeCompare(a.date));
---

{
  visible.length > 0 && (
    <ol class="plain-list dated">
      {visible.map((item) => {
        const ext = item.href ? isExternal(item.href) : false;
        return (
          <li class:list={['dated__item', { 'dated__item--archived': item.status === 'archived' }]}>
            <span class="dated__date mono">{formatDate(item.date)}</span>
            <div class="dated__body">
              <p class="dated__title">
                {item.title}
                {item.status === 'archived' && <span class="dated__tag">archived</span>}
              </p>
              {item.body && <Prose text={item.body} muted small />}
              {item.href && (
                <p class="dated__link">
                  <a href={withBase(item.href)} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
                    {item.hrefLabel ?? 'More'}
                  </a>
                </p>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  )
}

<style>
  .dated {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .dated__item {
    display: grid;
    gap: 0.25rem var(--space-5);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 40em) {
    .dated__item {
      grid-template-columns: 7.5rem 1fr;
    }
  }
  .dated__date {
    padding-top: 0.25rem;
  }
  .dated__title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--text-h4);
    letter-spacing: -0.01em;
    margin: 0 0 0.25rem;
  }
  .dated__tag {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    vertical-align: middle;
  }
  .dated__item--archived {
    opacity: 0.75;
  }
  .dated__link {
    margin: 0.4rem 0 0;
    font-family: var(--font-head);
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
