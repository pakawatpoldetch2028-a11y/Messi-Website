---
/**
 * The handwritten "Messi" mark. Renders the supplied image when
 * site.yaml → mark.src is set, and the nickname in text until then.
 */
import { Image } from 'astro:assets';
import { getSite } from '../lib/content';
import { resolveImage } from '../lib/images';

interface Props {
  size?: 'sm' | 'md' | 'lg' | 'h1' | 'h2';
  tone?: 'light' | 'dark';
  alt?: string; // override the alt text, e.g. just the nickname inside a heading
  class?: string;
}
const { size = 'md', tone = 'light', alt, class: className } = Astro.props;
const site = await getSite();
const resolved = site.mark?.published !== false ? resolveImage(site.mark?.src) : undefined;
---

<span class:list={['mark', `mark--${size}`, `mark--${tone}`, className]}>
  {
    resolved ? (
      <Image src={resolved} alt={alt ?? (site.mark?.alt || `${site.nickname}, handwritten`)} width={960} format="webp" class="mark__img" />
    ) : (
      <span class="mark__text" aria-label={site.nickname}>
        {site.nickname}
      </span>
    )
  }
</span>

<style>
  .mark {
    display: inline-block;
    line-height: 1;
  }
  .mark :global(.mark__img) {
    height: var(--mark-h, 2.4rem);
    width: auto;
  }
  .mark--sm {
    --mark-h: 1.6rem;
  }
  .mark--md {
    --mark-h: 2.4rem;
  }
  .mark--lg {
    --mark-h: 3.4rem;
  }
  /* Sized to sit inside a heading of the matching level */
  .mark--h1 {
    --mark-h: calc(var(--text-h1) * 1.2);
  }
  .mark--h2 {
    --mark-h: calc(var(--text-h2) * 1.45);
  }
  .mark--dark :global(.mark__img) {
    filter: invert(1) brightness(1.9);
  }
  .mark__text {
    font-family: var(--font-head);
    font-weight: 800;
    letter-spacing: -0.03em;
    font-size: var(--mark-h, 2.4rem);
    color: var(--ink);
  }
  .mark--dark .mark__text {
    color: var(--on-navy);
  }
</style>
