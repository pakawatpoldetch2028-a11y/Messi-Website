---
/** Renders a markdown string from a content file as rich text. */
import { md } from '../lib/markdown';

interface Props {
  text?: string;
  lead?: boolean;
  muted?: boolean;
  small?: boolean;
  class?: string;
}
const { text, lead = false, muted = false, small = false, class: className } = Astro.props;
---

{
  text && (
    <div
      class:list={['prose', { 'prose--lead': lead, 'prose--muted': muted, 'prose--small': small }, className]}
      set:html={md(text)}
    />
  )
}
