---
/**
 * A quiet network drawing: parts and the relationships between them. Used as
 * a decorative motif, always hidden from assistive technology.
 */
interface Props {
  class?: string;
  variant?: 'wide' | 'tall';
}
const { class: className, variant = 'wide' } = Astro.props;
---

{
  variant === 'wide' ? (
    <svg class:list={['ornament', className]} viewBox="0 0 600 220" aria-hidden="true" focusable="false">
      <g fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round">
        <path d="M40 160 L120 90 L210 130 L290 60 L370 120 L450 70 L540 140" />
        <path d="M120 90 L200 40 L290 60" />
        <path d="M210 130 L300 180 L370 120" />
        <path d="M370 120 L460 170 L540 140" />
        <path d="M450 70 L520 30" />
        <path d="M40 160 L110 200 L210 130" />
      </g>
      <g fill="currentColor">
        <circle cx="40" cy="160" r="3.4" />
        <circle cx="120" cy="90" r="3.4" />
        <circle cx="210" cy="130" r="4.2" />
        <circle cx="290" cy="60" r="3.4" />
        <circle cx="370" cy="120" r="4.2" />
        <circle cx="450" cy="70" r="3.4" />
        <circle cx="540" cy="140" r="3.4" />
        <circle cx="200" cy="40" r="2.6" />
        <circle cx="300" cy="180" r="2.6" />
        <circle cx="460" cy="170" r="2.6" />
        <circle cx="520" cy="30" r="2.6" />
        <circle cx="110" cy="200" r="2.6" />
      </g>
    </svg>
  ) : (
    <svg class:list={['ornament', className]} viewBox="0 0 220 600" aria-hidden="true" focusable="false">
      <g fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round">
        <path d="M60 40 L140 120 L80 210 L150 300 L70 390 L140 470 L90 560" />
        <path d="M140 120 L190 60" />
        <path d="M80 210 L30 260 L70 390" />
        <path d="M150 300 L200 350 L140 470" />
      </g>
      <g fill="currentColor">
        <circle cx="60" cy="40" r="3.4" />
        <circle cx="140" cy="120" r="4.2" />
        <circle cx="80" cy="210" r="3.4" />
        <circle cx="150" cy="300" r="4.2" />
        <circle cx="70" cy="390" r="3.4" />
        <circle cx="140" cy="470" r="3.4" />
        <circle cx="90" cy="560" r="3.4" />
        <circle cx="190" cy="60" r="2.6" />
        <circle cx="30" cy="260" r="2.6" />
        <circle cx="200" cy="350" r="2.6" />
      </g>
    </svg>
  )
}

<style>
  .ornament {
    color: var(--accent);
    opacity: 0.35;
    width: 100%;
    height: auto;
  }
</style>
