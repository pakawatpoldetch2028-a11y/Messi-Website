---
/** A compact list of links with small kind indicators. Empty links are hidden. */
import { href as withBase, isExternal } from '../lib/url';

interface Props {
  links?: { label: string; href: string; kind?: string; published?: boolean }[];
  heading?: string;
}
const { links = [], heading } = Astro.props;
const visible = links.filter((l) => l.published !== false && l.href);
const icons: Record<string, string> = {
  paper: 'M4 2h6l3 3v9H4z M10 2v3h3 M6 8h5 M6 11h5',
  site: 'M8 2a6 6 0 1 0 0 12A6 6 0 0 0 8 2z M2 8h12 M8 2c2 2 2 10 0 12 M8 2c-2 2-2 10 0 12',
  video: 'M2 4h9v8H2z M11 7l3-2v6l-3-2',
  download: 'M8 2v8 M5 7l3 3 3-3 M3 13h10',
  internal: 'M3 8h9 M8.5 3.5 13 8l-4.5 4.5',
  external: 'M6 3H3v10h10v-3 M9 3h4v4 M13 3 7 9',
};
---

{
  visible.length > 0 && (
    <div class="linklist">
      {heading && <p class="eyebrow">{heading}</p>}
      <ul class="plain-list linklist__list">
        {visible.map((l) => {
          const external = isExternal(l.href);
          const kind = l.kind ?? (external ? 'external' : 'internal');
          return (
            <li>
              <a
                class="linklist__link"
                href={withBase(l.href)}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener' : undefined}
                download={kind === 'download' && !external ? '' : undefined}
              >
                <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
                  <path d={icons[kind] ?? icons.external} fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{l.label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  )
}

<style>
  .linklist__list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .linklist__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-head);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .linklist__link svg {
    color: var(--cobalt);
    flex-shrink: 0;
  }
  .linklist__link span {
    border-bottom: 1px solid var(--line-strong);
    transition: border-color var(--dur) var(--ease);
  }
  .linklist__link:hover span {
    border-color: var(--cobalt);
  }
</style>
