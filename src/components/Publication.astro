---
import type { CollectionEntry } from 'astro:content';
import Prose from './Prose.astro';
import { mdInline } from '../lib/markdown';

interface Props {
  publication: CollectionEntry<'publications'>;
  compact?: boolean;
}
const { publication, compact = false } = Astro.props;
const p = publication.data;
const venue = [p.journal, p.volume && `vol. ${p.volume}`, p.issue && `no. ${p.issue}`, p.pages && `pp. ${p.pages}`]
  .filter(Boolean)
  .join(', ');
const statusLabel = p.status === 'in-press' ? 'In press' : p.status === 'in-progress' ? 'In progress' : undefined;
---

<article class:list={['pub', { 'pub--compact': compact }]}>
  <div class="pub__year mono">{p.year}</div>
  <div class="pub__body">
    <h3 class="pub__title">
      <a href={p.url} rel="noopener" target="_blank">{p.title}</a>
    </h3>
    <p class="pub__meta">
      {p.authors ? <span>{p.authors}. </span> : <span class="pub__role">{p.role}. </span>}
      {venue && <span>{venue}. </span>}
      {p.doi && (
        <span>
          DOI: <a href={`https://doi.org/${p.doi}`} rel="noopener" target="_blank">{p.doi}</a>
        </span>
      )}
      {statusLabel && <span class="pub__status mono">{statusLabel}</span>}
    </p>
    {!compact && p.summary && <Prose text={p.summary} muted small class="pub__summary" />}
    {!compact && p.contribution && (
      <p class="pub__contribution">
        <span class="mono">My part · </span>
        <span set:html={mdInline(p.contribution)} />
      </p>
    )}
    {!compact && p.authors && <p class="pub__role mono">{p.role}</p>}
  </div>
</article>

<style>
  .pub {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--line);
  }
  .pub--compact {
    padding: var(--space-4) 0;
  }
  .pub__year {
    padding-top: 0.4rem;
  }
  .pub__title {
    font-size: var(--text-h4);
    margin-bottom: 0.3rem;
  }
  .pub__title a {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
  }
  .pub__title a:hover {
    text-decoration-color: var(--cobalt);
  }
  .pub__meta {
    font-size: var(--text-sm);
    color: var(--ink-3);
    margin: 0 0 0.5rem;
  }
  .pub__role {
    color: var(--teal);
    font-weight: 600;
  }
  .pub__status {
    display: inline-block;
    margin-left: 0.3rem;
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .pub__contribution {
    font-size: var(--text-sm);
    color: var(--ink-2);
    margin: 0.5rem 0 0;
  }
  .pub__body > .pub__role {
    margin: 0.5rem 0 0;
    font-weight: 500;
  }
</style>
