---
import { href as withBase, isExternal } from '../lib/url';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'link';
  download?: boolean;
  class?: string;
}
const { href, variant = 'primary', download = false, class: className } = Astro.props;
const external = isExternal(href);
---

<a
  class:list={['button', `button--${variant}`, 'sans', className]}
  href={withBase(href)}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  download={download ? '' : undefined}
>
  <slot />
  <svg class="button__arrow" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M3 8h9M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.15rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 540;
    text-decoration: none;
    line-height: 1;
    border: 1px solid transparent;
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .button--primary {
    background: var(--ink);
    color: var(--paper);
  }
  .button--primary:hover {
    background: var(--accent-ink);
  }
  :root[data-theme='dark'] .button--primary:hover {
    background: var(--accent);
    color: var(--paper);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .button--primary:hover {
      background: var(--accent);
      color: var(--paper);
    }
  }
  .button--secondary {
    background: transparent;
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .button--secondary:hover {
    border-color: var(--ink);
  }
  .button--link {
    padding: 0.3rem 0;
    border-radius: 0;
    color: var(--accent-ink);
    border-bottom: 1px solid color-mix(in oklab, var(--accent) 45%, transparent);
  }
  .button--link:hover {
    border-color: var(--accent);
  }
  .button__arrow {
    transition: transform var(--dur) var(--ease);
  }
  .button:hover .button__arrow {
    transform: translateX(2px);
  }
</style>
