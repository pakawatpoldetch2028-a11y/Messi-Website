---
import { href as withBase, isExternal } from '../lib/url';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'link' | 'ghost';
  download?: boolean;
  class?: string;
}
const { href, variant = 'primary', download = false, class: className } = Astro.props;
const external = isExternal(href);
---

<a
  class:list={['button', `button--${variant}`, className]}
  href={withBase(href)}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  download={download ? '' : undefined}
>
  <slot />
  <svg class="button__arrow" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M3 8h9M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.2rem;
    border-radius: 999px;
    font-family: var(--font-head);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: -0.005em;
    text-decoration: none;
    line-height: 1;
    border: 1px solid transparent;
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .button--primary {
    background: var(--cobalt);
    color: #fff;
  }
  .button--primary:hover {
    background: var(--cobalt-ink);
  }
  .button--secondary {
    background: transparent;
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .button--secondary:hover {
    border-color: var(--ink);
  }
  .button--ghost {
    background: transparent;
    color: var(--on-navy);
    border-color: var(--navy-line);
  }
  .button--ghost:hover {
    border-color: var(--on-navy);
  }
  .button--link {
    padding: 0.3rem 0;
    border-radius: 0;
    color: var(--cobalt-ink);
    border-bottom: 1.5px solid color-mix(in oklab, var(--cobalt) 40%, transparent);
  }
  .button--link:hover {
    border-color: var(--cobalt);
  }
  .button__arrow {
    transition: transform var(--dur) var(--ease);
  }
  .button:hover .button__arrow {
    transform: translateX(3px);
  }
</style>
